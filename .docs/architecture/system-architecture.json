  "cards": [
    {
      "dot": "cyan",
      "title": "Start with an existing repository",
      "items": [
        "Windows PowerShell 5.1+, Git and Python 3.9+. Missing prerequisites get guidance; setup does not install them.",
        "Repositories can live under Repos or elsewhere. Setup never moves them."
      ]
    },
    {
      "dot": "emerald",
      "title": "Preserve first, reset explicitly",
      "items": [
        "One selected adapter: Codex, Claude Code, Cursor, Copilot or Antigravity. Existing instructions stay outside marked blocks.",
        "Reset backs up every supported local instruction and skill path before clearing any. Global skills and hooks remain untouched."
      ]
    },
    {
      "dot": "violet",
      "title": "One home per fact",
      "items": [
        "Cards hold live status; project folders hold history; Atomic Insights hold reusable facts. Registry and workspace pointers are ignored local JSON.",
        "zentora_sync.py checks registered paths read-only. It does not watch, archive, install hooks or trigger Graphify."
      ]
    },
    {
      "dot": "amber",
      "title": "Optional tools and clean sharing",
      "items": [
        "Engineering rules are opt-in. Obsidian and Graphify are optional. Manual graphify update MyOS uses no LLM; semantic extraction requires a separate explicit action.",
        "Clean export excludes maintainer notes, generated graphs, credentials, Git history and external skill bundles. Only DevKernel-owned skills ship."
      ]
    }
  ]
