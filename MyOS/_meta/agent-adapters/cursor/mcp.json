{
  "mcpServers": {
    "graphify": {
      "command": "python",
      "args": [
        "-m",
        "graphify.serve"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-fetch-server"
      ]
    }
  }
}
